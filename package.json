{
  "name": "brisbane-flood-explorer",
  "private": true,
  "scripts": {
    "test": "node --test tests/*.test.js",
    "test:smoke": "node tests/smoke_live.js",
    "test:sources": "node tests/probe_sources.js",
    "serve": "http-server viewer -p 8000 -c-1",
    "lint": "eslint viewer tests scripts eslint.config.mjs && node scripts/check-cdn-dependencies.js",
    "check:outdated": "npm outdated",
    "check:security": "npm audit --audit-level=low"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "eslint": "10.13.0",
    "globals": "17.13.0",
    "http-server": "14.1.1",
    "playwright": "1.55.1"
  },
  "dependencies": {
    "esri-leaflet": "3.0.12",
    "geotiff": "2.1.3",
    "leaflet": "1.9.4"
  },
  "engines": {
    "node": ">=22.13.0"
  }
}
